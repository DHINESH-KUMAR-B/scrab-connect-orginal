rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
  match /users/{id} { allow read, write: if request.auth.uid == id || role() == 'admin'; }
  match /collectors/{id} { allow read: if request.auth != null; allow create: if request.auth.uid == id; allow update: if request.auth.uid == id || role() == 'admin'; }
  match /pickups/{id} { allow create: if request.auth != null;
    allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.collectorId == request.auth.uid || role() == 'admin'); }
}}
